# =============================================================
# File này ĐƯỢC commit lên git — chỉ chứa tên biến, KHÔNG giá trị
# Sao chép thành .env.local rồi điền giá trị thật vào
# =============================================================

# URL backend API
VITE_API_URL=http://localhost:8080/api

# Google OAuth Client ID (lấy từ Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=

# Gemini API Keys (lấy từ https://aistudio.google.com/app/apikey)
VITE_GEMINI_KEY_1=
VITE_GEMINI_KEY_2=

# Groq API Key (lấy từ https://console.groq.com/keys)
VITE_GROQ_KEY=
